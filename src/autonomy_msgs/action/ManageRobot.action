# One supervised operation. Select a new goal after clearing E-stop.
uint8 NAVIGATE=0
uint8 DIG=1
uint8 DUMP=2
uint8 RUN_MACHINE=3
uint8 operation
# Used by RUN_MACHINE; registered in robot_super_intelligence/machines.
string machine_name
# Used by DIG/DUMP and machines containing those operations.
int32 routine_index
# Used by NAVIGATE. Machines resolve destinations from published arena markers.
geometry_msgs/PoseStamped target_pose
# Positive wall-clock deadline for every operation and machine.
float64 time_limit_sec
---
bool success
string outcome
uint32 completed_cycles
---
string state
string latest_outcome
uint32 completed_cycles
float64 elapsed_sec
